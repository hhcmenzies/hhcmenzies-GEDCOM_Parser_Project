################################################################################
# GEDCOM_Parser_Project - .gitignore
# Purpose: Keep repo clean of local/dev/runtime artifacts while tracking
#          source, schemas, datasets, docs, and scripts.
################################################################################

# ----------------------------
# IDE / editor
# ----------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ----------------------------
# OS junk
# ----------------------------
.DS_Store
Thumbs.db

# ----------------------------
# Python caches / bytecode
# ----------------------------
__pycache__/
*.py[cod]
*$py.class

# ----------------------------
# Virtual environments / env files
# ----------------------------
venv/
.venv/
env/
ENV/
.python-version
.env
.env.*
pip-wheel-metadata/

# ----------------------------
# Python build / packaging
# ----------------------------
build/
dist/
develop-eggs/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
wheels/

# ----------------------------
# Test / coverage / typecheck caches
# ----------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# ----------------------------
# Logs, dumps, and runtime artifacts
# ----------------------------
logs/
*.log
*.out
*.pid
*.dump

# Pipeline outputs / generated JSON
outputs/
parsed_data.json
validate_results*.json
tag_context_index*.json
*.json.zip

# ----------------------------
# Local databases & SQL artifacts (generated locally)
# (You have Postgres + local sqlite files; keep them out of git)
# ----------------------------
*.db
*.sqlite
*.sqlite3
*.sql.tmp
*.psql

# If you have specific generated SQL you *never* want committed:
# current_schema.sql
# gedcom_schema_postgresql_sanitized.sql

# ----------------------------
# Security-sensitive keys (never commit)
# ----------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
me
me.pub

# ----------------------------
# Archives / local scratch
# ----------------------------
archive/
tmp/
temp/

# ----------------------------
# Compressed / exports
# ----------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# ----------------------------
# Inventory policy (your current behavior preserved)
# - ignore timestamped runs
# - keep inventory/latest and legacy
# ----------------------------
inventory/*/
!inventory/latest
!inventory/legacy/**
inventory/latest/*
!inventory/latest/.keep

# ----------------------------
# Generated/compiled GEDCOM artifacts
# (Keep canonical/extensions/mocks tracked; ignore compiled + observed outputs)
# ----------------------------
datasets/gedcom/compiled/*.log
datasets/gedcom/compiled/*.tmp
datasets/gedcom/observed/*
datasets/gedcom/compiled/*
datasets/gedcom/observed/*
current_schema.sql

# ----------------------------
# Optional: ignore large GEDCOM samples if you don't want them tracked
# (COMMENT OUT if you want to keep mock_files under version control)
# ----------------------------
# mock_files/
# tests/data/

# Local reports/artifacts (generated)
gedcom55_tag_catalog_*.csv
gedcom55_tag_gaps_*.csv
gedcom_schema_postgresql_sanitized.sql

# Allow versioned reports (override ignores above)
!reports/
!reports/**

################################################################################
# Notes:
# - schemas/ and datasets/gedcom/{canonical,extensions,mocks}/ remain tracked.
# - outputs/, logs/, db files, and inventory timestamp folders stay out of git.
################################################################################
reports/

# Runtime artifacts
out/
reports/
inventory/
logs/
cache/
temp/

