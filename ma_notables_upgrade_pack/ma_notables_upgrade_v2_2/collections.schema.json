{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MA Notables Collections Config",
  "type": "object",
  "required": [
    "project",
    "collections"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "target_window"
      ],
      "properties": {
        "target_window": {
          "type": "object",
          "required": [
            "start_year",
            "end_year"
          ],
          "properties": {
            "start_year": {
              "type": "integer",
              "minimum": 1
            },
            "end_year": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slug",
          "label",
          "association",
          "window",
          "sources"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "type": "string"
          },
          "association": {
            "type": "object",
            "required": [
              "type",
              "label"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "categorized_as",
                  "event_in",
                  "period_in"
                ]
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "window": {
            "type": "object",
            "required": [
              "start_year",
              "end_year"
            ],
            "properties": {
              "start_year": {
                "type": "integer"
              },
              "end_year": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "title"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "category",
                    "list_page"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "traverse_subcategories": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
