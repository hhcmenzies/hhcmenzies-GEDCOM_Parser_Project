{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/c24_8_canonical_export.schema.json",
  "title": "GEDCOM Parser Canonical Export (C.24.8)",
  "description": "C.24.8 extends C.24.7 with place merge/split semantics registries (place_operations + place_redirects).",
  "type": "object",
  "allOf": [
    {
      "$ref": "c24_7_canonical_export.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "place_operations": {
          "description": "Optional ledger of place merge/split/supersede operations. Does not rewrite event pointers by itself; that is done by a dedicated builder later.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaceOperation"
          },
          "default": []
        },
        "place_redirects": {
          "description": "Optional redirect map from deprecated/alias place_id to canonical place_id(s). Redirect entries may be scoped by jurisdiction_system_id and temporal ranges.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PlaceRedirect"
            },
            "default": []
          },
          "default": {}
        }
      }
    }
  ],
  "$defs": {
    "TemporalRef": {
      "description": "Temporal scoping block for redirects. C.24.7 uses bucket=year; C.24.8 also allows start_year/end_year for redirect ranges.",
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "enum": ["year"]
        },
        "year": {
          "type": "integer",
          "minimum": 0
        },
        "start_year": {
          "type": "integer",
          "minimum": 0
        },
        "end_year": {
          "type": "integer",
          "minimum": 0
        },
        "open_ended": {
          "type": "boolean"
        }
      },
      "required": ["bucket"],
      "additionalProperties": true
    },
    "GeneratedMeta": {
      "description": "Generated/inferred metadata used throughout C.24.x. Present for enrichment and provenance.",
      "type": "object",
      "properties": {
        "by": { "type": "string" },
        "rule": { "type": "string" },
        "inferred": { "type": "boolean" },
        "enrichment_candidate": { "type": "boolean" },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": true
    },
    "PlaceRedirect": {
      "type": "object",
      "description": "A redirect from a legacy/alias place_id to a canonical place_id, optionally scoped by jurisdiction and time.",
      "properties": {
        "to_place_id": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction_system_id": {
          "type": "string",
          "minLength": 1
        },
        "temporal": {
          "$ref": "#/$defs/TemporalRef"
        },
        "reason": {
          "type": "string"
        },
        "op_id": {
          "description": "If produced from place_operations, link to the operation id.",
          "type": "string"
        },
        "generated": {
          "$ref": "#/$defs/GeneratedMeta"
        }
      },
      "required": ["to_place_id"],
      "additionalProperties": true
    },
    "PlaceOperation": {
      "type": "object",
      "description": "A place merge/split/supersede operation record. Intended to be stable and replayable.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["merge", "split", "supersede"]
        },
        "timestamp": {
          "description": "ISO-8601 timestamp or date string. Optional.",
          "type": "string"
        },
        "jurisdiction_system_id": {
          "type": "string"
        },
        "temporal": {
          "$ref": "#/$defs/TemporalRef"
        },
        "from_place_id": {
          "description": "Used by split/supersede.",
          "type": "string"
        },
        "from_place_ids": {
          "description": "Used by merge.",
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "to_place_id": {
          "description": "Used by merge/supersede.",
          "type": "string"
        },
        "to_place_ids": {
          "description": "Used by split.",
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "generated": {
          "$ref": "#/$defs/GeneratedMeta"
        }
      },
      "required": ["id", "kind"],
      "additionalProperties": true,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "merge" } } },
          "then": { "required": ["from_place_ids", "to_place_id"] }
        },
        {
          "if": { "properties": { "kind": { "const": "split" } } },
          "then": { "required": ["from_place_id", "to_place_ids"] }
        },
        {
          "if": { "properties": { "kind": { "const": "supersede" } } },
          "then": { "required": ["from_place_id", "to_place_id"] }
        }
      ]
    }
  }
}
